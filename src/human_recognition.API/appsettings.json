{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=human_recognition_db;User=human_recognition;Password=human_recognitionPassword;"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Properties": {
      "Application": "human_recognition.API"
    }
  },
  "JwtSettings": {
    "Secret": "af0BcqELcr73UCjn99ZkTDzc7nevqZN5",
    "Issuer": "human_recognition API",
    "Audience": "human_recognitionClients",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "AIModels": {
    "YoloxTinyPath": "D:\\Kantor\\Project\\Temp\\human_recognition\\models\\yolox_cctv.onnx"
  },
  "AllowedHosts": "*"
}
